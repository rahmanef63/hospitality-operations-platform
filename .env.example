NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOY_KEY=

# Private runtime secrets are owned by the Convex deployment, not the Next/Vercel runtime.
# Configure these with `npx convex env set ...` on the tenant deployment.
# HOSPITALITY_ADMIN_EMAIL=
# HOSPITALITY_ADMIN_PASSWORD=
# HOSPITALITY_ADMIN_SESSION_SECRET=
# HOSPITALITY_GUEST_LINK_SECRET=
# HOSPITALITY_AI_ENCRYPTION_KEY=
# HOSPITALITY_UPDATE_WORKFLOW_TOKEN=

# Tenant Actions worker configuration. Store the SAME update workflow token as a GitHub Actions secret.
# Repository variable: HOSPITALITY_CONVEX_SITE_URL=https://your-deployment.convex.site
# Repository secret:   HOSPITALITY_UPDATE_WORKFLOW_TOKEN=<same Convex worker token>

# Optional direct GitHub dispatch fallback for deployments that intentionally keep GitHub auth in Next.
# Preferred direct mode is a tenant-owned GitHub App; queue mode requires neither of these in Vercel.
HOSPITALITY_GITHUB_REPOSITORY=
HOSPITALITY_UPDATE_GITHUB_APP_ID=
HOSPITALITY_UPDATE_GITHUB_APP_PRIVATE_KEY=
HOSPITALITY_UPDATE_GITHUB_TOKEN=

# Public property facts. Leave blank until the owner supplies verified values.
# These values are read during the Docker build, so redeploy after changing them.
PRIMARY_PROPERTY_STREET_ADDRESS=
PRIMARY_PROPERTY_WHATSAPP_NUMBER=
PRIMARY_PROPERTY_GOOGLE_MAPS_EMBED_URL=
PRIMARY_PROPERTY_LATITUDE=
PRIMARY_PROPERTY_LONGITUDE=
