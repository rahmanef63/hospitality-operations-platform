# Environment contract for Hospitality Operations Platform.
# Copy to .env.local for local development. Names only, never values.
# `npm run env:check` fails when the code reads a name this file does not declare.

# --- Next.js / browser -------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_CONVEX_URL=

# --- Convex deployment secrets ----------------------------------------------
# Set on the Convex deployment with `npx convex env set NAME value`.
# `convex/lib/admin.ts` reads these through requireValue(), so they never load into Next.
# HOSPITALITY_ADMIN_EMAIL
# HOSPITALITY_ADMIN_PASSWORD
# HOSPITALITY_ADMIN_SESSION_SECRET
# Declared here because convex/*.ts reads them with process.env. Keep them empty in .env.local.
HOSPITALITY_AI_ENCRYPTION_KEY=
HOSPITALITY_GUEST_LINK_SECRET=
HOSPITALITY_UPDATE_WORKFLOW_TOKEN=

# --- Deployment only (never in the Next runtime) ----------------------------
# Tenant GitHub/CI secret used by `npx convex deploy`.
CONVEX_DEPLOY_KEY=

# --- Tenant Actions worker --------------------------------------------------
# Store the same update workflow token as a GitHub Actions secret.
# Repository variable: HOSPITALITY_CONVEX_SITE_URL=https://your-deployment.convex.site
HOSPITALITY_CONVEX_SITE_URL=

# --- Optional direct GitHub dispatch fallback -------------------------------
# Preferred direct mode is a tenant-owned GitHub App; queue mode needs none of these in Vercel.
HOSPITALITY_GITHUB_REPOSITORY=
HOSPITALITY_UPDATE_GITHUB_APP_ID=
HOSPITALITY_UPDATE_GITHUB_APP_PRIVATE_KEY=
HOSPITALITY_UPDATE_GITHUB_TOKEN=

# --- Public property facts --------------------------------------------------
# Leave blank until the owner supplies verified values.
# Read during the Docker build, so redeploy after changing them.
# Unset or malformed values are dropped, never guessed: see shared/config/primary-property.ts.
PRIMARY_PROPERTY_STREET_ADDRESS=
PRIMARY_PROPERTY_WHATSAPP_NUMBER=
PRIMARY_PROPERTY_GOOGLE_MAPS_EMBED_URL=
PRIMARY_PROPERTY_LATITUDE=
PRIMARY_PROPERTY_LONGITUDE=
# Structured data and address display. Without these the JSON-LD address is incomplete.
PRIMARY_PROPERTY_LOCALITY=
PRIMARY_PROPERTY_DESTINATION=
PRIMARY_PROPERTY_ADMINISTRATIVE_AREA=
PRIMARY_PROPERTY_REGION=
PRIMARY_PROPERTY_POSTAL_CODE=
PRIMARY_PROPERTY_COUNTRY_CODE=
PRIMARY_PROPERTY_COUNTRY_NAME=
PRIMARY_PROPERTY_DISPLAY_ADDRESS=
PRIMARY_PROPERTY_MAPS_PROFILE_URL=

# --- Provided by the platform, do not set in .env.local ---------------------
# Vercel and GitHub Actions inject these. Declared so env:check can tell an
# injected name from a missing one.
NODE_ENV=
VERCEL=
VERCEL_GIT_COMMIT_SHA=
VERCEL_GIT_REPO_OWNER=
VERCEL_GIT_REPO_SLUG=
GITHUB_SHA=
GITHUB_REPOSITORY=
GH_TOKEN=
SOURCE_COMMIT=
NEXT_PUBLIC_BUILD_VERSION=

# --- Tenant sync scripts (scripts/platform/sync-tenant.mjs) -----------------
TENANT_OWNER=
TENANT_REPO=
TENANT_DEFAULT_BRANCH=main
TENANT_TOKEN=
TENANT_DEPLOYMENT_ACTOR=
TENANT_REVIEWERS=
PLATFORM_TAG=

# --- Local smoke test (scripts/smoke-test.mjs) ------------------------------
SMOKE_URL=http://127.0.0.1:3000
