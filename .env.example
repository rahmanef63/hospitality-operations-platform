NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOY_KEY=

# Server-only admin credentials. Never prefix these with NEXT_PUBLIC_.
HOSPITALITY_ADMIN_EMAIL=
HOSPITALITY_ADMIN_PASSWORD=
HOSPITALITY_ADMIN_SESSION_SECRET=
HOSPITALITY_CONVEX_ADMIN_SECRET=
HOSPITALITY_GUEST_LINK_SECRET=
HOSPITALITY_AI_ENCRYPTION_KEY=

# Tenant platform update center. Server-only; never expose through NEXT_PUBLIC_.
# HOSPITALITY_GITHUB_REPOSITORY can be omitted on Vercel when Git system vars resolve owner/repo.
HOSPITALITY_GITHUB_REPOSITORY=
# Preferred: a tenant-owned GitHub App installed only on the tenant repository.
HOSPITALITY_UPDATE_GITHUB_APP_ID=
HOSPITALITY_UPDATE_GITHUB_APP_PRIVATE_KEY=
# Fallback for tenants that intentionally use a fine-grained token.
HOSPITALITY_UPDATE_GITHUB_TOKEN=

# Coordinated update GitHub repository configuration (set as repository variables/secrets, not app env):
# variable HOSPITALITY_SITE_URL=https://provider.example
# variable HOSPITALITY_VERCEL_MODE=git  # or hook
# secret   CONVEX_DEPLOY_KEY=<tenant production deploy key>
# secret   VERCEL_DEPLOY_HOOK_URL=<required only for hook mode>

# Public property facts. Leave blank until the owner supplies verified values.
# These values are read during the Docker build, so redeploy after changing them.
PRIMARY_PROPERTY_STREET_ADDRESS=
PRIMARY_PROPERTY_WHATSAPP_NUMBER=
PRIMARY_PROPERTY_GOOGLE_MAPS_EMBED_URL=
PRIMARY_PROPERTY_LATITUDE=
PRIMARY_PROPERTY_LONGITUDE=
