{
  "$schema": "https://raw.githubusercontent.com/rahmanef63/resource-site/main/packages/cli/lib/rr-schema.json",
  "version": 1,
  "framework": "next-16",
  "style": "shadcn-new-york",
  "rsc": true,
  "tailwind": {
    "config": "",
    "css": "app/globals.css"
  },
  "aliases": {
    "components": "@/components",
    "ui": "@/components/ui",
    "shared": "@/shared",
    "templates": "@/slices",
    "slices": "@/features",
    "features": "@/features",
    "lib": "@/lib"
  },
  "layout": {
    "kind": "vertical-slice",
    "publicRoute": "app/(marketing)",
    "sliceRoot": "slices"
  },
  "features": [
    {
      "slug": "tv-pwa",
      "version": "1.1.0",
      "description": "Fullscreen configurable guest slideshow, CC0 lo-fi audio, install lifecycle, offline fallback, and version restart."
    },
    {
      "slug": "guest-announcements",
      "version": "1.0.0",
      "description": "Property-scoped time-window, fixed-time, and verified-coordinate prayer announcements with opt-in speech and presentation ambient audio."
    }
  ],
  "slices": [
    {
      "slug": "site-shell",
      "version": "1.1.0",
      "category": "navigation",
      "addedAt": "2026-08-28"
    },
    {
      "slug": "concierge",
      "version": "1.0.0",
      "category": "guest-experience",
      "addedAt": "2026-08-28"
    },
    {
      "slug": "home",
      "version": "1.0.0",
      "category": "marketing",
      "addedAt": "2026-08-28"
    },
    {
      "slug": "property",
      "version": "1.0.0",
      "category": "hospitality",
      "addedAt": "2026-08-28"
    },
    {
      "slug": "brand-assets",
      "version": "1.0.0",
      "category": "brand",
      "addedAt": "2026-08-28"
    },
    {
      "slug": "guides",
      "version": "1.0.0",
      "category": "editorial",
      "addedAt": "2026-08-28"
    },
    {
      "slug": "welcome",
      "version": "1.3.0",
      "category": "guest-experience",
      "addedAt": "2026-08-28"
    },
    {
      "slug": "admin",
      "version": "2.1.0",
      "category": "operations",
      "addedAt": "2026-08-28"
    },
    {
      "slug": "pms",
      "version": "1.0.0",
      "category": "operations",
      "addedAt": "2026-08-28"
    },
    {
      "slug": "cms",
      "version": "1.0.0",
      "category": "operations",
      "addedAt": "2026-08-30"
    }
  ],
  "skills": [
    {
      "slug": "sc-all",
      "source": "rahman",
      "version": "main",
      "addedAt": "2026-08-28"
    }
  ],
  "auth": {
    "provider": "env-cookie",
    "session": "signed-http-only-cookie",
    "loginRateLimit": "convex-cloud"
  },
  "convex": {
    "mode": "cloud",
    "urlEnv": "NEXT_PUBLIC_CONVEX_URL",
    "generatedDir": "convex/_generated",
    "domains": [
      "welcome",
      "adminSecurity",
      "pms",
      "welcomeReservations",
      "aiSettings",
      "announcements",
      "cms"
    ]
  }
}
