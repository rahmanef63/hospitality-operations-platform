{
  "name": "hospitality-operations-platform",
  "version": "0.1.14",
  "private": true,
  "description": "Location-neutral hospitality website for Hospitality Operations Platform.",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint proxy.ts app convex slices shared lib scripts tests --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:file-size": "node scripts/validation/audit-file-size.mjs",
    "audit:slices": "node scripts/validation/audit-slices.mjs",
    "audit:rr-rules": "node scripts/validation/audit-rr-rules.mjs",
    "audit:brand-copy": "node scripts/validation/audit-brand-copy.mjs",
    "check:stack-pin": "node scripts/validation/check-stack-pin.mjs",
    "env:check": "node scripts/env-check.mjs",
    "audit": "bun run check:stack-pin && bun run audit:file-size && bun run audit:slices && bun run audit:manifest && bun run audit:rr-rules && bun run audit:brand-copy",
    "verify": "bun run env:check && bun run audit && bun run typecheck && bun run typecheck:convex && bun run lint && bun run test && bun run build",
    "smoke": "node scripts/smoke-test.mjs",
    "audit:manifest": "node scripts/validation/audit-project-manifest.mjs",
    "platform:release:check": "node scripts/platform/check-release.mjs",
    "platform:version": "node scripts/platform/set-version.mjs",
    "platform:tenant:provision": "node scripts/platform/provision-tenant.mjs",
    "typecheck:convex": "tsc --project convex/tsconfig.json --noEmit"
  },
  "dependencies": {
    "adhan": "^4.4.4",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "convex-test": "^0.0.56",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0.3",
    "vitest": "^3.2.4"
  }
}
