{
  "schemaVersion": 1,
  "strategy": "upstream-release-pr",
  "tenantProtectedPrefixes": [
    ".env",
    ".vercel/",
    ".platform/tenant.json",
    ".platform/tenant.lock.json",
    "tenant/",
    "public/tenant/",
    "shared/tenant/",
    "convex/tenant/",
    "public/favicon.ico",
    "public/favicon.svg",
    "public/apple-touch-icon.png",
    "app/icon.svg",
    "public/pwa/screenshots/"
  ],
  "requiredTenantFiles": [
    ".platform/tenant.json",
    ".platform/tenant.lock.json"
  ],
  "updater": {
    "branchPrefix": "platform/update-",
    "appIdSecret": "HOSPITALITY_UPDATER_APP_ID",
    "privateKeySecret": "HOSPITALITY_UPDATER_PRIVATE_KEY"
  }
}
